# SMTP Email Configuration (required for staff/manager verification emails)

# Brevo (recommended) - https://www.brevo.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false

# Your Brevo SMTP login (usually your Brevo account email)
SMTP_USER=your-brevo-login@example.com

# Your Brevo SMTP key (NOT your account password - generate in Brevo > SMTP & API)
SMTP_PASS=your-brevo-smtp-key

# Verified sender email in Brevo (must be verified in Brevo dashboard)
SMTP_FROM_EMAIL=noreply@yourdomain.com

# Frontend URL (used in email links)
FRONTEND_URL=http://localhost:3000
